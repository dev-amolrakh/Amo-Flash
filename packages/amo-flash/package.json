{
  "name": "amo-flash",
  "version": "1.0.0",
  "description": "Beautiful, accessible flash messages (toasts) for any framework — a morphing pill with a live countdown, smart dedupe, promise states and built-in sound. Zero dependencies.",
  "keywords": [
    "toast",
    "toasts",
    "notification",
    "notifications",
    "flash",
    "flash-message",
    "snackbar",
    "alert",
    "react",
    "vue",
    "svelte",
    "angular",
    "vanilla",
    "framework-agnostic",
    "accessible"
  ],
  "license": "MIT",
  "author": "dev-amolrakh (https://github.com/dev-amolrakh)",
  "homepage": "https://amo-flash.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dev-amolrakh/Amo-Flash.git",
    "directory": "packages/amo-flash"
  },
  "bugs": {
    "url": "https://github.com/dev-amolrakh/Amo-Flash/issues"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/amo-flash.global.js",
  "jsdelivr": "./dist/amo-flash.global.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./vue": {
      "import": {
        "types": "./dist/vue.d.ts",
        "default": "./dist/vue.js"
      },
      "require": {
        "types": "./dist/vue.d.cts",
        "default": "./dist/vue.cjs"
      }
    },
    "./svelte": {
      "import": {
        "types": "./dist/svelte.d.ts",
        "default": "./dist/svelte.js"
      },
      "require": {
        "types": "./dist/svelte.d.cts",
        "default": "./dist/svelte.cjs"
      }
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "jsdom": "^26.1.0",
    "react": "^19.2.9",
    "react-dom": "^19.2.9",
    "tsup": "^9.0.0",
    "typescript": "~5.9.3",
    "vitest": "^5.1.1"
  }
}
